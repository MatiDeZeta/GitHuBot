{
	"name": "githubot",
	"version": "1.2.1",
	"description": "Beautiful Discord changelog messages for GitHub activity — zero GitHub credentials required",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/index.ts",
		"build": "tsc",
		"start": "node --env-file-if-exists=.env dist/index.js",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"audit:supply-chain": "pnpm install --frozen-lockfile && pnpm audit --audit-level moderate && node scripts/check-store-integrity.mjs",
		"generate:languages": "node scripts/generate-language-colors.mjs",
		"emojis:render": "node scripts/render-octicons.mjs",
		"emojis:sync": "tsx --env-file-if-exists=.env src/tools/sync-emojis.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
	},
	"dependencies": {
		"@fastify/rate-limit": "^11.2.0",
		"@octokit/webhooks-methods": "^6.0.0",
		"better-sqlite3": "^13.0.1",
		"discord.js": "^14.27.0",
		"drizzle-orm": "^0.45.3",
		"fastify": "^5.12.5",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"postgres": "^3.4.9",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@primer/octicons": "19.38.0",
		"@resvg/resvg-wasm": "2.6.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.13.6",
		"drizzle-kit": "^0.31.11",
		"linguist-languages": "9.5.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
