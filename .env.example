# Discord bot credentials (from https://discord.com/developers/applications)
# Optional at boot — without them the process still serves /health (degraded mode).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register slash commands to a single guild instantly during development
# DISCORD_GUILD_ID=

# Optional: only this Discord user ID may run /repo commands (and event selects).
# Leave empty to allow anyone with Manage Server.
# DISCORD_ALLOWED_USER_ID=

# 32-byte key for AES-256-GCM encryption of webhook secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Public base URL of this bot, used in /repo add setup instructions.
# Either a full URL or a bare host (https is assumed), e.g. githubot.up.railway.app
PUBLIC_WEBHOOK_URL=http://localhost:3000

# SQLite file path (default) or Postgres connection string.
# SQLite:  file:./data/githubot.db
# Postgres: postgresql://user:pass@host:5432/githubot
DATABASE_URL=file:./data/githubot.db

# HTTP server
PORT=3000
HOST=0.0.0.0

# Required for per-IP rate limiting to work behind a reverse proxy (Railway, Docker,
# nginx). Without it every request looks like it came from the proxy, so the rate
# limit shares one bucket for all callers.
# Accepts true/false or a comma-separated IP/CIDR list. A bare hop count ("2") is
# rejected on purpose: that form allows X-Forwarded-For spoofing (GHSA-3m5p-2c4r-xxw2).
# TRUST_PROXY=true

# Largest accepted GitHub delivery, in bytes. Defaults to GitHub's own 25 MiB cap.
# Lower it to cut how much an unauthenticated request can buffer before the
# signature is checked; raising it above 25 MiB is rejected.
# WEBHOOK_BODY_LIMIT=26214400

# Deliveries accepted per minute from one IP (default 600). GitHub sends from a
# small pool of addresses and does not retry a 429, so keep this well above your
# busiest repository's CI burst.
# WEBHOOK_RATE_LIMIT=600

# When set, /metrics requires `Authorization: Bearer <token>` (min 16 chars).
# /health stays public so platform health checks keep working.
# METRICS_TOKEN=

# ---------------------------------------------------------------- dashboard --

# Optional read-only web dashboard (delivery status, pause/resume, test message).
# OFF unless DASHBOARD_ENABLED is true AND the two values below are set — a default
# deployment serves no dashboard route at all.
#
# Sign-in is Discord OAuth2: a user sees only servers where they hold Manage Server.
# Add <DASHBOARD_BASE_URL>/dashboard/auth/callback as a redirect URI in the Discord
# Developer Portal (OAuth2 -> Redirects), then restart.
# If DISCORD_ALLOWED_USER_ID is set, only that account may sign in.
# DASHBOARD_ENABLED=false
# DASHBOARD_BASE_URL=https://your-bot.example.com
# DISCORD_CLIENT_SECRET=
# DASHBOARD_SESSION_HOURS=12

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
NODE_ENV=development

# ---------------------------------------------------------------- appearance --

# Default accent palette for new servers: default | github | neon | mono | language
# DEFAULT_THEME=default

# Default display density for new servers: detailed | compact
# DEFAULT_DISPLAY_MODE=detailed

# Default language. Ships with `en` and `es`.
# DEFAULT_LOCALE=en

# Swap the built-in Unicode icons for custom application emojis.
# Keys are icon names (push, merged, failure, star, shield, …).
# EMOJI_OVERRIDES={"push":"<:push:123456789012345678>","merged":"<:merged:123456789012345678>"}

# ------------------------------------------------------------------ presence --

# Discord only renders the purple "Streaming" badge for twitch.tv / youtube.com
# URLs. Leave unset to skip the Streaming activity entirely.
# PRESENCE_STREAM_URL=https://twitch.tv/yourchannel

# Replace the whole rotation. Supported types: playing, streaming, listening,
# watching, competing, custom. Placeholders: {repos} {servers} {events}
# {uptime} {ping} {version}
# PRESENCE_ROTATION=[{"type":"watching","name":"{repos} repos"},{"type":"custom","name":"Custom Status","state":"{events} events today"}]

# NOTE: No GITHUB_TOKEN is required or accepted.
# GitHuBot never authenticates to the GitHub API.
