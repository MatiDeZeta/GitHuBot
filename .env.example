# Discord bot credentials (from https://discord.com/developers/applications)
# Optional at boot — without them the process still serves /health (degraded mode).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register slash commands to a single guild instantly during development
# DISCORD_GUILD_ID=

# Optional: only this Discord user ID may run /repo commands (and event selects).
# Leave empty to allow anyone with Manage Server.
# DISCORD_ALLOWED_USER_ID=

# 32-byte key for AES-256-GCM encryption of webhook secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Public base URL of this bot (no trailing slash). Used in /repo add setup instructions.
# Example: https://githubot.up.railway.app
# Public base URL (https://… or bare host like foo.up.railway.app — https is assumed)
PUBLIC_WEBHOOK_URL=http://localhost:3000

# SQLite file path (default) or Postgres connection string.
# SQLite:  file:./data/githubot.db
# Postgres: postgresql://user:pass@host:5432/githubot
DATABASE_URL=file:./data/githubot.db

# HTTP server
PORT=3000
HOST=0.0.0.0

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
NODE_ENV=development

# ---------------------------------------------------------------- appearance --

# Default accent palette for new servers: default | github | neon | mono | language
# DEFAULT_THEME=default

# Default display density for new servers: detailed | compact
# DEFAULT_DISPLAY_MODE=detailed

# Default language. Currently only `en` ships; the i18n layer is ready for more.
# DEFAULT_LOCALE=en

# Swap the built-in Unicode icons for custom application emojis.
# Keys are icon names (push, merged, failure, star, shield, …).
# EMOJI_OVERRIDES={"push":"<:push:123456789012345678>","merged":"<:merged:123456789012345678>"}

# ------------------------------------------------------------------ presence --

# Discord only renders the purple "Streaming" badge for twitch.tv / youtube.com
# URLs. Leave unset to skip the Streaming activity entirely.
# PRESENCE_STREAM_URL=https://twitch.tv/yourchannel

# Replace the whole rotation. Supported types: playing, streaming, listening,
# watching, competing, custom. Placeholders: {repos} {servers} {events}
# {uptime} {ping} {version}
# PRESENCE_ROTATION=[{"type":"watching","name":"{repos} repos"},{"type":"custom","name":"Custom Status","state":"{events} events today"}]

# NOTE: No GITHUB_TOKEN is required or accepted.
# GitHuBot never authenticates to the GitHub API.
